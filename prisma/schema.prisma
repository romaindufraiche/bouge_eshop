// Schéma de données de la boutique BOUGE.
//
// Dev  : SQLite (aucun serveur à installer, le fichier vit dans prisma/dev.db)
// Prod : PostgreSQL — il suffit de passer `provider` à "postgresql" et de
//        pointer DATABASE_URL sur la base Postgres. Le schéma ci-dessous
//        n'utilise volontairement AUCUNE fonctionnalité absente de SQLite
//        (pas d'`enum`, pas de listes de scalaires) pour que le même fichier
//        fonctionne dans les deux environnements sans réécriture.
//
// Convention prix : tous les montants sont des entiers en CENTIMES d'euro.
// On évite ainsi toute erreur d'arrondi en virgule flottante, et c'est déjà
// l'unité attendue par Stripe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // prod : remplacer par "postgresql"
  url      = env("DATABASE_URL")
}

/// Compte administrateur de la boutique (un seul suffit, la table en autorise
/// plusieurs si besoin plus tard).
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

/// Catégorie de produits (bonnets, lunettes, accessoires, vêtements…).
/// Créable et renommable depuis l'admin.
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  /// Ordre d'affichage dans les menus et la page catalogue.
  position Int @default(0)

  /// SEO : surchargent les valeurs calculées si renseignés.
  metaTitle       String?
  metaDescription String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position])
  @@map("categories")
}

/// Produit vendu en boutique.
model Product {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// Prix de vente normal, en centimes.
  priceCents Int

  /// Prix promotionnel, en centimes. Null = pas de promo.
  /// La promo n'est active que si `salePriceCents` est renseigné ET que la
  /// date du jour tombe dans la fenêtre [saleStartsAt, saleEndsAt] (bornes
  /// optionnelles : null = pas de limite de ce côté).
  salePriceCents Int?
  saleStartsAt   DateTime?
  saleEndsAt     DateTime?

  /// "DRAFT" (brouillon, invisible du public) ou "PUBLISHED" (en ligne).
  /// Valeurs contrôlées côté application (src/lib/constants.ts) plutôt que par
  /// un enum Prisma, indisponible sur SQLite.
  status String @default("DRAFT")

  /// Stock utilisé quand le produit n'a PAS de variante.
  /// Dès qu'il existe des variantes, c'est leur stock qui fait foi.
  stock Int @default(0)

  /// Mis en avant en haut de la page d'accueil. Un seul à la fois en
  /// pratique : la page n'affiche que le plus récent.
  featured Boolean @default(false)

  /// Produit vendu par un tiers (éditeur, revendeur). Renseigné, la fiche
  /// renvoie vers ce lien au lieu de proposer l'ajout au panier, et le
  /// produit ne peut pas être commandé sur le site.
  externalUrl String?

  /// Nom du revendeur affiché sur le bouton, par exemple « la Fnac ».
  /// Laissé vide, le nom de domaine du lien est utilisé.
  externalLabel String?

  /// Également disponible à la boutique, à signaler sur la fiche.
  availableInStore Boolean @default(false)

  /// SEO : surchargent les valeurs calculées si renseignés.
  metaTitle       String?
  metaDescription String?

  images   ProductImage[]
  variants ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@map("products")
}

/// Photo d'un produit. `position` porte l'ordre choisi dans l'admin.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Chemin public (/uploads/…) ou URL absolue si stockage externe.
  url String

  /// Texte alternatif, obligatoire pour l'accessibilité et le SEO.
  alt String

  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_images")
}

/// Déclinaison d'un produit : taille et/ou couleur.
/// Un produit sans variante (une paire de lunettes taille unique) n'a
/// simplement aucune ligne ici.
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String?
  color String?

  /// Référence interne facultative.
  sku String?

  stock Int @default(0)

  /// Prix spécifique à la variante, en centimes. Null = prix du produit.
  priceCents Int?

  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId, position])
  @@map("product_variants")
}

/// Point de retrait (boutique, club, piscine partenaire).
model PickupPoint {
  id           String  @id @default(cuid())
  name         String
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String

  /// Horaires en texte libre, affichés tels quels dans le tunnel.
  hours String?

  isActive Boolean @default(true)
  position Int     @default(0)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pickup_points")
}

/// Commande client.
model Order {
  id String @id @default(cuid())

  /// Référence lisible communiquée au client (ex. BG-7F3K2A).
  reference String @unique

  email        String
  customerName String
  phone        String?

  /// "PENDING" (créée, paiement non confirmé), "PAID", "PREPARING",
  /// "SHIPPED", "COLLECTED", "CANCELLED". Voir src/lib/constants.ts.
  status String @default("PENDING")

  /// "DELIVERY" (livraison France) ou "PICKUP" (retrait sur place).
  fulfilment String

  // --- Adresse de livraison (renseignée si fulfilment = "DELIVERY") ---
  shippingAddressLine1 String?
  shippingAddressLine2 String?
  shippingPostalCode   String?
  shippingCity         String?
  shippingCountry      String? @default("FR")

  // --- Point de retrait (renseigné si fulfilment = "PICKUP") ---
  pickupPointId String?
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id])

  subtotalCents Int
  shippingCents Int @default(0)
  totalCents    Int

  // --- Traçabilité Stripe ---
  stripeSessionId       String? @unique
  stripePaymentIntentId String?
  paidAt                DateTime?

  /// Note interne visible uniquement dans l'admin.
  adminNote String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Ligne d'une commande.
/// Les libellés et le prix sont RECOPIÉS au moment de la commande : si le
/// produit est renommé ou son prix changé plus tard, la commande passée garde
/// ce qui a réellement été vendu.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Références d'origine, conservées pour les statistiques.
  /// Mises à null si le produit est supprimé — la ligne reste lisible grâce
  /// aux libellés recopiés ci-dessous.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// Libellés figés au moment de l'achat.
  productName  String
  variantLabel String?
  imageUrl     String?

  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@map("order_items")
}

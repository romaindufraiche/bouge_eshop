# ---------------------------------------------------------------------------
# Les photos envoyées depuis l'administration atterrissent ici.
#
# Ce dossier ne doit JAMAIS exécuter de code : si quelqu'un parvenait à y
# déposer un fichier .php malgré les contrôles de type, il ne serait servi
# qu'en texte. C'est la dernière barrière, et elle doit exister même si les
# contrôles en amont sont corrects.
# ---------------------------------------------------------------------------

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
AddHandler cgi-script .php .phtml .pl .py .sh

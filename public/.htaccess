# ---------------------------------------------------------------------------
# BOUGE. — règles du serveur web
#
# Ce fichier suppose Apache avec mod_rewrite, ce qu'offrent tous les
# hébergements mutualisés courants (OVH, Ionos, o2switch, Hostinger…).
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Toutes les requêtes qui ne correspondent pas à un fichier ou un dossier
    # réel passent par le contrôleur frontal.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# On n'expose pas la liste des fichiers d'un dossier sans index.
Options -Indexes

# Compression des réponses texte : pages plus légères, affichage plus rapide.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Mise en cache longue des fichiers statiques, qui portent un numéro de
# version dans leur adresse et changent donc de nom à chaque modification.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

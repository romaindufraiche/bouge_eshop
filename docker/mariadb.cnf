# MariaDB partage 512 Mo avec Apache et PHP sur l'offre gratuite de Render.
# Ces réglages la font tenir dans une centaine de mégaoctets. Ils conviennent
# à une démonstration, pas à une boutique en production.
[mysqld]
skip-networking = 0
bind-address = 127.0.0.1
skip-name-resolve

innodb_buffer_pool_size = 32M
innodb_log_buffer_size = 4M
innodb_flush_method = O_DIRECT_NO_FSYNC

key_buffer_size = 8M
tmp_table_size = 8M
max_heap_table_size = 8M
max_connections = 20
table_open_cache = 64

performance_schema = OFF

# ---------------------------------------------------------------------------
# Configuration BOUGE. — copier ce fichier en `.env` puis remplir les valeurs.
# `.env` n'est jamais versionné (voir .gitignore).
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
# Dev  (SQLite, aucun serveur à installer) :
DATABASE_URL="file:./dev.db"
# Prod (PostgreSQL) — penser à passer `provider = "postgresql"` dans
# prisma/schema.prisma :
# DATABASE_URL="postgresql://user:motdepasse@host:5432/bouge?schema=public"

# --- URL publique du site --------------------------------------------------
# Sert aux URLs de retour Stripe et aux métadonnées SEO (canonical, OpenGraph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentification de l'admin -------------------------------------------
# Secret de signature du cookie de session. En générer un avec :
#   openssl rand -base64 32
AUTH_SECRET="a-remplacer-par-un-secret-aleatoire-de-32-caracteres-minimum"

# Compte administrateur créé par `npm run db:seed`.
# Après le premier lancement, le mot de passe peut être changé depuis /admin.
ADMIN_EMAIL="contact@bouge.fr"
ADMIN_PASSWORD="changez-moi"

# --- Stripe ----------------------------------------------------------------
# Clés disponibles sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Secret du webhook, donné par `stripe listen` en local ou par le dashboard
# Stripe en production (endpoint : <site>/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Stockage des images produits ------------------------------------------
# "local"      : les fichiers sont écrits dans public/uploads (dev).
# "cloudinary" : bascule sur Cloudinary (voir src/lib/storage.ts).
UPLOAD_DRIVER="local"
# Renseigner uniquement si UPLOAD_DRIVER="cloudinary" :
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
